@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Line Item',
    typeNamePlural: 'Line Items',
    title: { type: #STANDARD, value: 'ItemNo' }
  }
}
annotate view ZC_JT_ExpItem with
{
  @UI.hidden: true
  ItemUuid;

  @UI.hidden: true
  ParentUuid;

  @UI: { lineItem: [{ position: 10 }] }
  ItemNo;

  @UI: { lineItem: [{ position: 20 }] }
  ExpenseType;

  @UI: { lineItem: [{ position: 30 }] }
  ExpenseDate;

  @UI: { lineItem: [{ position: 40 }] }
  Amount;

  @UI: { lineItem: [{ position: 50 }] }
  Remark;
}