projection;
strict ( 2 );
use draft;

define behavior for ZC_JT_ExpClaim alias Claim
{
  use create;
  use update;
  use delete;
  use association _Item { create; with draft; }

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action approve;
  use action reject;
  use action copyClaim;
}

define behavior for ZC_JT_ExpItem alias Item
{
  use update;
  use delete;
  use association _Claim { with draft; }
}